{
  "name": "fazuraverse",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/image-proxy", "destination": "/api/image-proxy" },
    { "source": "/api/resolve-mega", "destination": "/api/resolve-mega" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
